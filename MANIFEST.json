{
  "manifest_version": "2.0",
  "project": "pokemontology",
  "audit_date": "2026-07-21",
  "license_scope": "Project-authored material only; see LICENSE and THIRD_PARTY_NOTICES.md.",
  "project_positioning": {
    "unofficial": true,
    "independent": true,
    "not_official_source": true,
    "not_affiliated_with": [
      "Nintendo",
      "Game Freak",
      "Creatures Inc.",
      "The Pokémon Company"
    ]
  },
  "sources": [
    {
      "id": "pokeapi",
      "name": "PokeAPI",
      "url": "https://github.com/PokeAPI/pokeapi",
      "license_or_terms": "BSD-3-Clause for covered upstream repository software; no blanket data-content conclusion",
      "version_or_retrieval": "user-selected at retrieval time; not vendored",
      "transformations": [
        "select resources",
        "normalize identifiers",
        "map supported fields to RDF",
        "emit evidence metadata"
      ],
      "redistribution_status": "reference-only",
      "uncertainty": "Rights in API content and underlying franchise data are not established by the software license alone."
    },
    {
      "id": "pokemon-showdown-protocol",
      "name": "Pokémon Showdown replay protocol",
      "url": "https://github.com/smogon/pokemon-showdown",
      "license_or_terms": "MIT for covered server software; replay/user content separately controlled",
      "version_or_retrieval": "user-selected; no third-party payload vendored",
      "transformations": [
        "parse protocol events",
        "emit project RDF assertions and provenance"
      ],
      "redistribution_status": "reference-only",
      "uncertainty": "Replay payloads may contain usernames, chat, teams, private access data, and other user content."
    },
    {
      "id": "project-authored",
      "name": "Pokemontology project-authored source",
      "url": "https://github.com/laurajoyhutchins/pokemontology",
      "license_or_terms": "MIT subject to repository LICENSE boundary",
      "version_or_retrieval": "repository commit",
      "transformations": [
        "assemble ontology modules",
        "assemble SHACL modules",
        "generate schema indexes and site copies"
      ],
      "redistribution_status": "included",
      "uncertainty": "Generated outputs can contain third-party facts and require artifact-specific review."
    },
    {
      "id": "synthetic-fixtures",
      "name": "Project-authored synthetic fixtures",
      "url": "examples/fixtures/",
      "license_or_terms": "MIT subject to LICENSE boundary",
      "version_or_retrieval": "2026-07-21",
      "transformations": [
        "used directly by tests",
        "optional deterministic slice generation"
      ],
      "redistribution_status": "included",
      "uncertainty": "Synthetic examples are not evidence of official game behavior."
    },
    {
      "id": "veekun",
      "name": "Veekun Pokédex",
      "url": "https://github.com/veekun/pokedex",
      "license_or_terms": "upstream repository terms for covered upstream work; franchise-data boundary unresolved",
      "version_or_retrieval": "user-supplied revision; not vendored",
      "transformations": [
        "select CSV tables",
        "normalize identifiers",
        "emit version-scoped RDF"
      ],
      "redistribution_status": "reference-only",
      "uncertainty": "No blanket redistribution basis established for all structured franchise data or prose."
    }
  ],
  "artifacts": [
    {
      "path": "build/mechanics*.ttl",
      "classification": "generated-external-data",
      "inputs": [
        "pokeapi",
        "veekun"
      ],
      "command": "source-specific ingest command documented in README",
      "tool_and_schema_version": "pokemontology 0.1.0; exact source revision required at generation",
      "checked_in": "owner-review-required",
      "generated": true,
      "redistribution_status": "owner-review-required"
    },
    {
      "path": "build/ontology.ttl",
      "classification": "generated-project-model",
      "inputs": [
        "ontology/modules/"
      ],
      "command": "python3 -m pokemontology build",
      "tool_and_schema_version": "pokemontology 0.1.0",
      "checked_in": true,
      "generated": true,
      "redistribution_status": "included"
    },
    {
      "path": "docs/mechanics-learnsets-legacy.ttl",
      "classification": "quarantined-generated-external-data",
      "inputs": [
        "pokeapi",
        "veekun"
      ],
      "command": "local source-specific ingest followed by python3 -m pokemontology build",
      "tool_and_schema_version": "pokemontology 0.1.0; exact historical inputs not established",
      "checked_in": false,
      "generated": true,
      "redistribution_status": "quarantined"
    },
    {
      "path": "docs/ontology.ttl",
      "classification": "generated-publication-copy",
      "inputs": [
        "ontology/modules/"
      ],
      "command": "python3 -m pokemontology build",
      "tool_and_schema_version": "pokemontology 0.1.0",
      "checked_in": true,
      "generated": true,
      "redistribution_status": "included"
    },
    {
      "path": "examples/fixtures/synthetic-battle-slice.ttl",
      "classification": "project-authored-synthetic-fixture",
      "inputs": [
        "examples/fixtures/synthetic-battle.json"
      ],
      "command": "python3 -m pokemontology build-slice examples/fixtures/synthetic-battle.json -o examples/fixtures/synthetic-battle-slice.ttl",
      "tool_and_schema_version": "pokemontology 0.1.0; fixture schema 1",
      "checked_in": true,
      "generated": true,
      "redistribution_status": "included"
    },
    {
      "path": "examples/fixtures/synthetic-battle.json",
      "classification": "project-authored-synthetic-fixture",
      "inputs": [
        "synthetic-fixtures"
      ],
      "command": "none",
      "tool_and_schema_version": "fixture schema 1",
      "checked_in": true,
      "generated": false,
      "redistribution_status": "included"
    },
    {
      "path": "ontology/modules/",
      "classification": "project-authored-model",
      "inputs": [
        "project-authored"
      ],
      "command": "python3 -m pokemontology build",
      "tool_and_schema_version": "pokemontology 0.1.0; ontology version declared in modules",
      "checked_in": true,
      "generated": false,
      "redistribution_status": "included"
    }
  ],
  "forbidden_public_patterns": [
    "data/**/raw/**",
    "docs/mechanics-learnsets-legacy.ttl",
    "examples/replays/*.json",
    "**/*.sqlite",
    "**/*.sqlite3",
    "**/*.db",
    "**/*password*",
    "**/*private-replay*",
    "**/*.zip",
    "**/*.tar",
    "**/*.tar.gz"
  ]
}
